# ===================================================================
# Variables de entorno de Palma Travel
# Copiá este archivo como .env.local y completá los valores.
# El archivo .env.local NUNCA se sube a GitHub.
# ===================================================================

# --- Dirección del sitio ---------------------------------------------
# Sin barra al final. En desarrollo: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://palmatravel.com.py

# --- Supabase (base de datos, login y fotos) -------------------------
# Se sacan del panel de Supabase, en Project Settings → API.
# Estas dos son públicas: viajan al navegador, no son un secreto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ ESTA ES SECRETA. Nunca la compartas ni la subas a GitHub.
# Solo la usa el servidor (el panel y el script de carga inicial).
SUPABASE_SERVICE_ROLE_KEY=

# --- Analítica (opcional) --------------------------------------------
# Si los dejás vacíos, simplemente no se carga nada de analítica.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Revalidación (opcional) -----------------------------------------
# Clave propia para poder refrescar el sitio desde afuera.
# Inventá una cadena larga y difícil de adivinar.
REVALIDATE_SECRET=
